# On your laptop: copy this file to ".env" and change the values. Never share or upload your real .env.
# On Render: type these in the "Environment" page instead.

PORT=3000

# Online database (Neon). Leave EMPTY on a laptop (it then uses the file data/db.json).
# On Render this is REQUIRED, otherwise all data is lost whenever the server restarts.
DATABASE_URL=

# Secret the cabinet sends with every scan. Use a long random text (30+ characters).
# Put the SAME text in the ESP32 firmware (LOCKER_KEY).
LOCKER_KEY=change-me-locker-key

# Locker rules (must match RULES in the app's src/config.js)
OPEN_HOUR=7
CLOSE_HOUR=21
DROP_OFF_FEE=5
HOURLY_FEE=5
LATE_FEE_PER_HOUR=5
MAX_LATE_FEE=50
LATE_GRACE_MINUTES=15

# true = sample students and past uses (good for demos). false = only the admin and 3 lockers.
SEED_DEMO=true

# ---------------- SMS ----------------
# log       = only print the text in the server log (default, free, for testing)
# textbee   = textbee.dev: a spare Android phone with a SIM sends the texts (recommended)
# semaphore = Semaphore.co (needs an approved Sender Name and paid credits)
# android   = a phone on the SAME WiFi as the server (not for Render)
SMS_DRIVER=log

# textbee
SMS_TEXTBEE_KEY=
SMS_TEXTBEE_DEVICE_ID=

# semaphore
SMS_SEMAPHORE_KEY=
SMS_SENDER=

# android
SMS_ANDROID_URL=
SMS_ANDROID_PATH=/message
SMS_ANDROID_USER=
SMS_ANDROID_PASS=

# ---------------- Email for reset codes (optional) ----------------
# Leave empty and the 6-digit code is only printed in the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
